# Sideload / debug signing for android/build.sh.
# Copy this file to android/keystore.properties (that copy is gitignored) and point it at a keystore
# that lives outside the repository. Do not commit the keystore or the passwords.
# Environment variables override this file: DROP_HAVOC_KEYSTORE, DROP_HAVOC_KS_PASS,
# DROP_HAVOC_KEY_PASS, DROP_HAVOC_KEY_ALIAS.
#
# storeFile may be absolute, or relative to the android/ directory.
# Passwords are the text after the first '='. Do not wrap them in quotes.

storeFile=/path/to/your-debug.keystore
storePassword=change-me
keyAlias=arena
keyPassword=change-me
