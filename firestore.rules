rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Player reports are write-only. A client may create one and cannot read, edit, or delete any report.
    match /reports/{id} {
      allow create: if request.resource.data.reporterId is string
        && request.resource.data.reportedId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() < 200
        && request.resource.data.snippet is string
        && request.resource.data.snippet.size() < 240
        && request.resource.data.at is timestamp;
      allow read, update, delete: if false;
    }
  }
}
