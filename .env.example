# DroP-Havoc — public multiplayer test server
# PORT is assigned automatically by Render.
BOTS=4
TRUST_PROXY=1
# Optional: Google web OAuth client ID for verified players.
# GOOGLE_CLIENT_ID=
# ADMIN_CODE must be generated and stored privately in hosting settings.
# Persistent economy is optional for testing, required before keeping valuable player progress.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Admin roles and bans still need persistent DATA_DIR storage in a permanent deployment.
